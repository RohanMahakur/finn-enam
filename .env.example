# --- Models (all optional; with none set FINN runs rules + arithmetic only) ---
GEMINI_API_KEY=          # free tier: cheap + mid tiers (bulk extraction, transcripts)
ANTHROPIC_API_KEY=       # strong tier: judging promises, writing the case
GROQ_API_KEY=            # free fallback for the cheap tier
# Override routing (comma-separated provider:model fallback chains)
# FINN_MODEL_CHEAP=gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-20b
# FINN_MODEL_MID=gemini:gemini-3-flash-preview
# FINN_MODEL_STRONG=anthropic:claude-sonnet-5-5

# --- Push (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=              # e.g. finn-rohan-7x3k → install the ntfy app and subscribe
FINN_PUSH_MIN=70         # only alerts at/above this severity leave the app
FINN_APP_URL=            # deployed URL, used for deep links in pushes

# --- Ops ---
FINN_RUN_TOKEN=          # protects POST /api/run
# FINN_NSE_BASES=https://www.nseindia.com,https://www.nseindia.in
